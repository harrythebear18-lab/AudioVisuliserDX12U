<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native AOT disabled — incompatible with WinForms/System.Drawing. Use ReadyToRun at publish instead. -->
    <!-- <PublishAot>true</PublishAot> -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Strip debug symbols on publish -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Pre-build: compile all HLSL shaders to embedded bytecode -->
  <Target Name="CompileShaders" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)compile_shaders.ps1&quot; -ShaderDir &quot;$(ProjectDir)..\\shaders&quot; -OutDir &quot;$(ProjectDir)compiled_shaders&quot;"
          IgnoreExitCode="true" />
  </Target>

  <!-- Embed compiled shader bytecode as resources -->
  <ItemGroup>
    <EmbeddedResource Include="compiled_shaders\*.dxbc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.DXC" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="SkiaSharp" Version="3.0.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.0.0" />
    <PackageReference Include="Silk.NET.OpenXR" Version="2.21.0" />
    <PackageReference Include="Silk.NET.OpenXR.Extensions.KHR" Version="2.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioPipeline\AudioPipeline.csproj" />
    <ProjectReference Include="..\AudioTransport\AudioTransport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\native\WASAPINative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
